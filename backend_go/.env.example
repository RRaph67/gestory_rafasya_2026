APP_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Supabase Postgres connection string.
# Prefer the pooled connection string from Supabase for hosted environments.
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional for authenticated routes. Found in Supabase project settings > API.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# JWKS URL for Supabase ECDSA verification (recommended over JWT secret)
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
