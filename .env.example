# ============================================================
#  GESTORY — Environment Variables Template
#  Salin file ini: cp .env.example .env
#  Lalu isi nilai yang diperlukan (terutama Supabase credentials)
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_ENV=development

# ── Backend (Go API) ────────────────────────────────────────
# URL frontend yang diizinkan akses ke backend (CORS)
FRONTEND_URL=http://localhost:3000

# Supabase Postgres — ambil dari Supabase Dashboard > Settings > Database
# Gunakan "Transaction pooler" URL (port 6543) untuk production
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT Secret — Supabase Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# JWKS URL — ganti YOUR_PROJECT_REF dengan project ref Supabase kamu
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ── Frontend (Next.js) ───────────────────────────────────────
# URL backend API. Saat Docker, frontend akses backend via host
# Jika menggunakan Docker Compose: gunakan http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase public credentials — aman untuk di-expose ke client
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Set true untuk pakai mock API (tanpa backend aktif)
NEXT_PUBLIC_USE_MOCK_API=false
